# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# env files (can opt-in for committing if needed)
.env*
.dev.vars

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
/.local/

# Browser adapters and their reviewed exports are application source.
!/app/data/
!/app/data/generated/
!/app/data/t1-benchmark-results.ts
!/app/data/t1-benchmark-media.server.ts
!/app/data/generated/t1-benchmark-results.json
/public/media
/public/episode-media
/public/vlm-l1-samples
/public/l1-minimal-media
/public/l1-phase1-media

# static site snapshot (data + curated clips), published as a release asset; see scripts/export-static-site.mjs
/public/static-api/
/public/static-media/
